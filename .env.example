# ===========================================================================
# AI Recruitment System — environment variables (example)
# Copy to .env and fill in. NEVER commit real secrets, tokens, resumes or PII.
# With the defaults below the whole stack + test suite runs locally with NO
# external credentials (deterministic mocks + in-process Postgres via PGlite).
# ===========================================================================

# ----- Runtime mode ---------------------------------------------------------
# local  = PGlite in-process Postgres, local JWT auth, filesystem storage,
#          deterministic mock AI + mock virus scanner (DEFAULT, no creds).
# supabase = real Supabase Postgres/Auth/Storage/Realtime (needs creds below).
NODE_ENV=development
ARS_RUNTIME=local

# ----- API server -----------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated allowed CORS origins for the SPA.
WEB_ORIGIN=http://localhost:5173
# Secret used to sign local-mode JWTs. MUST be overridden in any shared env.
LOCAL_JWT_SECRET=dev-only-insecure-secret-change-me
# Request body / upload limits.
MAX_UPLOAD_BYTES=10485760

# ----- Database (supabase / production runtime) -----------------------------
# Standard Postgres connection string used when ARS_RUNTIME=supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Filesystem directory for the local storage adapter (ARS_RUNTIME=local).
LOCAL_STORAGE_DIR=.storage

# ----- Supabase (only needed when ARS_RUNTIME=supabase) ---------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=resumes

# ----- AI providers ---------------------------------------------------------
# AI_PROVIDER: mock (default, deterministic) | anthropic | openai
AI_PROVIDER=mock
# EMBEDDING_PROVIDER: mock (default, deterministic) | openai
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=384
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ----- Virus scanning -------------------------------------------------------
# VIRUS_SCANNER: mock (default — flags EICAR test signature) | clamav
# Production MUST set a real scanner; the API refuses to start in production
# (NODE_ENV=production + ARS_RUNTIME=supabase) when VIRUS_SCANNER=mock.
VIRUS_SCANNER=mock
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ----- Frontend (Vite) ------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_DEFAULT_LOCALE=ja
