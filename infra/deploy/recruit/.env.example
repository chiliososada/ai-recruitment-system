# recruit.toyousoft.co.jp production env.
# 1) python3 gen-keys.py > .env   (generates the four secrets below)
# 2) append/adjust the rest of this file, then run ./deploy.sh
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME

# AI providers: mock = deterministic built-in (no external calls / no keys).
# Switch to anthropic/openai + set the keys when ready, then restart api.
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

APP_VERSION=0.1.0
GIT_COMMIT=unknown
